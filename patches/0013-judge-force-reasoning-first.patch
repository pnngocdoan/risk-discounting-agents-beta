+def _generate_text(prompts, eval_model, tokenizer, device, max_new_tokens):
+    """Generate a continuation for each prompt; returns only the new text."""
+    inputs = tokenizer(prompts, return_tensors="pt", truncation=True, padding=True)
+    cfg = dict(generation_config)
+    cfg["max_new_tokens"] = max_new_tokens
+    generation_output = eval_model.generate(
+        input_ids = inputs["input_ids"].to(device),
+        attention_mask = inputs['attention_mask'].to(device),
+        eos_token_id=tokenizer.eos_token_id,
+        pad_token_id=tokenizer.pad_token_id,
+        return_dict_in_generate=True,
+        output_scores=True,
+        **cfg
+    )
+    generation_output = generation_output.sequences
+    generation_output = generation_output[:, inputs['input_ids'].size(1):]
+    return tokenizer.batch_decode(generation_output, skip_special_tokens=True)
+
+
+def _clean_reasoning(text):
+    """Keep only the reasoning: stop at any verdict the model started writing, end on a full sentence."""
+    for stop in ("Final answer", "[Answer]", "[Final answer]"):
+        if stop in text:
+            text = text[:text.index(stop)]
+    text = text.rstrip()
+    if "." in text and not text.endswith((".", "!", "?")):
+        text = text[:text.rindex(".") + 1]
+    return text.strip()
+
