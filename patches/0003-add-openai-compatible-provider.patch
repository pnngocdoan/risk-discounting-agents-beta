@@ -0,0 +1,12 @@
+import os
+import sys
+sys.path.append('./model_api')
+from openai import OpenAI
+from OpenaiAPI import OpenaiAPI
+
+
+class GenericAPI(OpenaiAPI):
+    """Any OpenAI-compatible service. Reads RDA_BASE_URL and RDA_API_KEY from the environment."""
+    def __init__(self, model_name, generation_config={}):
+        super().__init__(model_name, generation_config)
+        self.client = OpenAI(base_url=os.environ['RDA_BASE_URL'], api_key=os.environ['RDA_API_KEY'])
